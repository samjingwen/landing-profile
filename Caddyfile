:8080 {
	encode zstd gzip

	handle /healthz {
		respond "ok" 200
	}

	handle {
		root * /srv

		@immutable path /assets/*
		header @immutable Cache-Control "public, max-age=31536000, immutable"

		@images path /images/*
		header @images Cache-Control "public, max-age=604800"

		@index path / /index.html
		header @index Cache-Control "no-cache"

		file_server
	}
}
